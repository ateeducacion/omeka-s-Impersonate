<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    colors="true"
    backupGlobals="false"
    bootstrap="./bootstrap.php"
    >
    <testsuites>
        <testsuite name="ImpersonateTest">
            <directory>./ImpersonateTest</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true"><include><file>../Module.php</file><directory suffix=".php">../src</directory></include></coverage>
</phpunit>
